{
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"lib": ["ESNext", "DOM"],
		"module": "Preserve",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		"noEmit": true,
		"noFallthroughCasesInSwitch": true,
		"noImplicitOverride": true,
		"noPropertyAccessFromIndexSignature": false,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"paths": {
			"@repo/shared": ["./packages/shared/src/index.ts"],
			"@repo/shared/*": ["./packages/shared/src/*"]
		},
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun"],
		"verbatimModuleSyntax": true
	},
	// The apps check themselves; the root covers the repo scripts. TypeScript's wildcards skip dot folders, so those are listed by name.
	"include": ["scripts", ".github/scripts", ".claude/hooks"]
}
