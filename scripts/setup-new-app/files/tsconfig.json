{
	// pulled from bun init
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"types": ["bun"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		// "noUncheckedIndexedAccess": true, // annoying
		"noImplicitOverride": true,

		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false,

		"paths": {
			"shared/*": ["./shared/*"]
		}
	},
	// TypeScript's wildcards skip dot folders, so the CI and hook scripts are listed by name. All of `.claude` would pull in the agent worktrees under it.
	"include": ["**/*", ".github/scripts", ".claude/hooks"],
	// Xcode checks Swift packages out under DerivedData, and some ship JavaScript that allowJs would check.
	"exclude": ["node_modules", "**/DerivedData"]
}
