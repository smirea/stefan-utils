#!/bin/bash
set -euo pipefail

repo_dir=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_dir"
if [ "$#" -gt 1 ]; then
    echo 'Usage: ./scripts/open [iPhone simulator name or UDID]' >&2
    exit 1
fi

developer_dir=${DEVELOPER_DIR:-$(xcode-select -p)}
simulator_app="$developer_dir/Applications/Simulator.app"
device_hub="$developer_dir/../Applications/DeviceHub.app"
if [ ! -d "$simulator_app" ] && [ ! -d "$device_hub" ]; then
    echo 'Install Xcode and select it with xcode-select before running this script.' >&2
    exit 1
fi

mkdir -p DerivedData
device_id=$(xcrun simctl list --json | python3 -c '
import json, pathlib, subprocess, sys

def version(value):
    return tuple(int(part) for part in value.split("."))

data = json.load(sys.stdin)
requested = sys.argv[1]
runtimes = sorted((r for r in data["runtimes"] if r.get("isAvailable")
                   and ".iOS-" in r["identifier"] and version(r["version"]) >= (17,)),
                  key=lambda r: version(r["version"]), reverse=True)
devices = [d for runtime in runtimes for d in data["devices"].get(runtime["identifier"], [])
           if d.get("isAvailable") and d["name"].startswith("iPhone")]
cache = pathlib.Path("DerivedData/simulator-udid")
saved = cache.read_text().strip() if cache.exists() else ""
if requested:
    matches = [d for d in devices if requested in (d["name"], d["udid"])]
    if not matches:
        sys.exit("No matching available iPhone simulator. Use xcrun simctl list devices available.")
    device_id = matches[0]["udid"]
elif devices:
    device = next((d for d in devices if d["udid"] == saved), None)
    device = device or next((d for d in devices if d["state"] == "Booted"), devices[0])
    device_id = device["udid"]
else:
    if not runtimes:
        sys.exit("Install an iOS 17 or newer simulator runtime in Xcode > Settings > Components.")
    runtime = runtimes[0]
    supported = {d["identifier"] for d in runtime.get("supportedDeviceTypes", [])}
    types = [d for d in data["devicetypes"] if d["name"].startswith("iPhone")
             and (d["identifier"] in supported if supported else
                  version(d.get("minRuntimeVersionString", "0")) <= version(runtime["version"]) <=
                  version(d.get("maxRuntimeVersionString", "999")))]
    if not types:
        sys.exit("No compatible iPhone device type. Install one through Xcode.")
    device = types[0]
    device_id = subprocess.check_output(
        ["xcrun", "simctl", "create", device["name"], device["identifier"], runtime["identifier"]],
        text=True).strip()
cache.write_text(device_id + "\n")
print(device_id)
' "${1:-}")

echo "Building App for ${device_id}…"
if ! xcodebuild -quiet -project App.xcodeproj -scheme App \
    -configuration Debug -sdk iphonesimulator \
    -destination "platform=iOS Simulator,id=$device_id" \
    -derivedDataPath DerivedData CODE_SIGNING_ALLOWED=NO build >DerivedData/simulator-build.log 2>&1; then
    cat DerivedData/simulator-build.log >&2
    exit 1
fi

xcrun simctl bootstatus "$device_id" -b
if [ -d "$device_hub" ]; then
    open -a "$device_hub" "devices://device/open?id=$device_id"
else
    open -a "$simulator_app" --args -CurrentDeviceUDID "$device_id"
fi
xcrun simctl install "$device_id" DerivedData/Build/Products/Debug-iphonesimulator/App.app
xcrun simctl launch --terminate-running-process "$device_id" __BUNDLE_ID__
